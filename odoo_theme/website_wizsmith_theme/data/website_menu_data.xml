<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The stock "Home" menu already points to "/": rename it instead of adding a duplicate entry.
             The other menu entries (Comment ça fonctionne, Solutions, ...) are intentionally NOT created here:
             existing sites already have them, and creating them again shows every item twice in the header.
             The header renders whatever is configured under Website > Configuration > Menus. -->
        <record id="website.menu_home" model="website.menu">
            <field name="name">Accueil</field>
            <field name="sequence" type="int">10</field>
        </record>
    </data>
</odoo>
