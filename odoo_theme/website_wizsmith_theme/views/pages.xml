    <!-- Page: Prise de Rendez-Vous & Diagnostic Terrain (/page/appointment) -->
    <!-- Compatible avec le module Probuse Website Customer Appointment Management & Integration with Calendar -->
    <template id="wizsmith_page_appointment" name="Rendez-Vous Expert WizSmith">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Header Banner -->
                <section class="py-5 bg-light border-bottom text-center">
                    <div class="container py-4">
                        <span class="badge px-3 py-1 rounded-pill mb-2" style="background: rgba(0,71,171,0.1); color: #0047AB;">
                            Audit &amp; Rendez-Vous Expert
                        </span>
                        <h1 class="display-5 fw-extrabold text-dark mb-3" style="color: #1A1A2E;">
                            Planifier votre diagnostic sur site à Abidjan
                        </h1>
                        <p class="lead text-secondary max-w-xl mx-auto fs-6">
                            Un ingénieur certifié WizSmith évalue vos accès, vos caméras et vos économies potentielles. Gratuit et sans engagement.
                        </p>
                    </div>
                </section>

                <!-- Appointment Booking Section & Backend Calendar Hook -->
                <section class="py-5 bg-white">
                    <div class="container py-lg-4">
                        <t t-if="request.params.get('status') == 'error'">
                            <div class="alert alert-danger rounded-4 p-4 mb-4 text-center border-0 shadow-sm" role="alert">
                                <p class="mb-0 fw-semibold">
                                    <t t-if="request.params.get('msg') == 'missing_fields'">Merci de renseigner au minimum votre nom et un numéro de téléphone valide.</t>
                                    <t t-elif="request.params.get('msg') == 'invalid_date'">Merci de choisir une date d'audit à venir.</t>
                                    <t t-else="">Votre demande n'a pas pu être enregistrée. Merci de réessayer ou de nous contacter sur WhatsApp.</t>
                                </p>
                            </div>
                        </t>
                        <t t-if="request.params.get('status') == 'success'">
                            <div class="alert alert-success rounded-4 p-4 mb-4 text-center border-0 shadow-sm">
                                <h4 class="fw-bold text-success mb-2">🎉 Rendez-vous d'audit enregistré avec succès !</h4>
                                <p class="mb-2 text-dark">
                                    Numéro de dossier : <strong class="badge bg-success font-monospace fs-6" t-esc="request.params.get('ref') or 'WZ-RDV-2026'"/>
                                </p>
                                <p class="small text-secondary mb-0">
                                    Merci pour votre confiance. Un expert WizSmith vous contactera sur WhatsApp pour confirmer la visite sur site à Abidjan.
                                </p>
                            </div>
                        </t>

                        <div class="row g-5 align-items-start justify-content-center">
                            <!-- Booking Form Column -->
                            <div class="col-lg-7">
                                <div class="card p-4 p-lg-5 rounded-4 border shadow-sm">
                                    <h4 class="fw-bold mb-4 text-dark">Réservation en Ligne</h4>
                                    <form action="/website/appointment/submit" method="post" class="d-flex flex-column gap-3">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Type de propriété</label>
                                                <select name="property_type" class="form-select form-select-sm">
                                                    <option value="villa">Villa / Maison privée</option>
                                                    <option value="airbnb">Appartement / Location Airbnb</option>
                                                    <option value="hotel">Hôtel / Résidence hôtelière</option>
                                                    <option value="office">Bureaux / Siège d'entreprise</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Commune à Abidjan</label>
                                                <select name="commune" class="form-select form-select-sm">
                                                    <option value="cocody">Cocody (Riviera, Angré, Deux Plateaux)</option>
                                                    <option value="marcory">Marcory (Zone 4, Biétry)</option>
                                                    <option value="plateau">Plateau</option>
                                                    <option value="bingerville">Bingerville</option>
                                                    <option value="yopougon">Yopougon</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Date souhaitée</label>
                                                <input type="date" name="appointment_date" class="form-control form-control-sm" required="required" t-att-min="(datetime.date.today() + datetime.timedelta(days=1)).isoformat()"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Créneau horaire</label>
                                                <select name="time_slot" class="form-select form-select-sm">
                                                    <option value="09:00 - 10:30">09:00 - 10:30 (Matin)</option>
                                                    <option value="10:30 - 12:00">10:30 - 12:00 (Matin)</option>
                                                    <option value="14:00 - 15:30">14:00 - 15:30 (Après-midi)</option>
                                                    <option value="15:30 - 17:00">15:30 - 17:00 (Fin de journée)</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Nom et Prénom</label>
                                                <input type="text" name="customer_name" class="form-control form-control-sm" placeholder="ex: Jean-Marc K." required="required"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Téléphone WhatsApp</label>
                                                <input type="tel" name="phone" class="form-control form-control-sm" placeholder="+225 07 00 00 00 00" required="required"/>
                                            </div>
                                        </div>

                                        <div>
                                            <label class="form-label small fw-bold">Précisions (Optionnel)</label>
                                            <textarea name="notes" rows="2" class="form-control form-control-sm" placeholder="Ex: Nombre d'accès, caméras existantes..."></textarea>
                                        </div>

                                        <div class="mt-3">
                                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3" style="background-color: #0047AB; border-color: #0047AB;">
                                                Confirmer mon rendez-vous
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Customer Reassurance & Value Column -->
                            <div class="col-lg-5">
                                <div class="card p-4 rounded-4 border bg-light shadow-sm">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <span class="fs-4">✨</span>
                                        <h5 class="fw-bold mb-0 text-dark">Pourquoi planifier votre audit ?</h5>
                                    </div>
                                    <p class="small text-secondary mb-3">
                                        Nos ingénieurs certifiés se déplacent gratuitement à Abidjan pour concevoir votre installation domotique et sécurité sur-mesure.
                                    </p>
                                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-3 text-secondary">
                                        <li>✓ <strong>100% Gratuit &amp; Sans engagement :</strong> étude de faisabilité complète sur site</li>
                                        <li>✓ <strong>Démonstration en direct :</strong> test des serrures connectées et caméras IA sur mallette</li>
                                        <li>✓ <strong>Chiffrage sous 24h :</strong> remise d'un plan d'implantation et devis détaillé</li>
                                        <li>✓ <strong>Garantie WizRenouv :</strong> éligibilité au renouvellement annuel du matériel</li>
                                    </ul>
                                    <div class="p-3 rounded-3 bg-white border small">
                                        <strong class="text-dark d-block mb-1">Astreinte &amp; Assistance Abidjan :</strong>
                                        <span class="text-muted">WhatsApp direct : <strong>+225 07 48 92 11 04</strong> (Lun - Sam, 08h-19h)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- Page: WizFix - Déclaration de Panne & Support SAV (/claim) -->
    <!-- Mappé sur le modèle Odoo maintenance.request -->
    <template id="wizsmith_page_claim" name="WizFix Maintenance &amp; Dépannage">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="py-5 bg-light border-bottom text-center">
                    <div class="container py-4">
                        <span class="badge px-3 py-1 rounded-pill mb-2" style="background: rgba(0,71,171,0.1); color: #0047AB;">
                            SAV &amp; Intervention Rapide 24h
                        </span>
                        <h1 class="display-5 fw-extrabold text-dark mb-3" style="color: #1A1A2E;">
                            Services WizFix : Dépannage &amp; Support
                        </h1>
                        <p class="lead text-secondary max-w-xl mx-auto fs-6">
                            Signalez une anomalie technique sur vos serrures, caméras ou passerelles. Nos techniciens d'astreinte interviennent à Abidjan.
                        </p>
                    </div>
                </section>

                <section class="py-5 bg-white">
                    <div class="container py-lg-4">
                        <t t-if="request.params.get('status') == 'success'">
                            <div class="alert alert-success rounded-4 p-4 mb-4 text-center border-0 shadow-sm" role="status">
                                <h4 class="fw-bold text-success mb-2">Demande WizFix enregistrée</h4>
                                <p class="mb-0 text-dark">Référence : <strong class="badge bg-success font-monospace fs-6" t-esc="request.params.get('ref')"/> — un technicien vous recontactera très vite.</p>
                            </div>
                        </t>
                        <t t-if="request.params.get('status') == 'error'">
                            <div class="alert alert-danger rounded-4 p-4 mb-4 text-center border-0 shadow-sm" role="alert">
                                Merci de renseigner votre nom, un numéro de téléphone valide et la description de la panne.
                            </div>
                        </t>
                        <div class="row g-5 justify-content-center">
                            <div class="col-lg-7">
                                <div class="card p-4 p-lg-5 rounded-4 border shadow-sm">
                                    <h4 class="fw-bold mb-4 text-dark">Déclarer un Incident Matériel</h4>
                                    <form action="/website/claim/submit" method="post" class="d-flex flex-column gap-3">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Votre Nom &amp; Prénom</label>
                                                <input type="text" name="customer_name" class="form-control form-control-sm" required="required" placeholder="ex: Patrick Boni"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Téléphone WhatsApp</label>
                                                <input type="tel" name="phone" class="form-control form-control-sm" required="required" placeholder="+225 07..."/>
                                            </div>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Équipement concerné</label>
                                                <select name="equipment_type" class="form-select form-select-sm">
                                                    <option value="lock">Serrure WizLock (Batterie ou blocage)</option>
                                                    <option value="camera">Caméra WizVision / Module IA</option>
                                                    <option value="gateway">Passerelle Wifi / Zigbee déconnectée</option>
                                                    <option value="ac">Thermostat ou relais clim</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold">Commune à Abidjan</label>
                                                <select name="commune" class="form-select form-select-sm">
                                                    <option value="cocody">Cocody (Riviera, Angré)</option>
                                                    <option value="marcory">Marcory (Zone 4)</option>
                                                    <option value="plateau">Plateau</option>
                                                    <option value="bingerville">Bingerville</option>
                                                    <option value="yopougon">Yopougon</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="form-label small fw-bold">Niveau d'urgence</label>
                                            <select name="priority" class="form-select form-select-sm">
                                                <option value="normal">Standard</option>
                                                <option value="urgent">Urgent (intervention sous 24h)</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="form-label small fw-bold">Description de la panne</label>
                                            <textarea name="description" rows="3" class="form-control form-control-sm" required="required" placeholder="Précisez le symptôme constaté..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 mt-2" style="background-color: #0047AB; border-color: #0047AB;">
                                            Envoyer ma demande d'assistance WizFix
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="card p-4 rounded-4 border bg-light">
                                    <h5 class="fw-bold mb-3 text-dark">Comment ça se passe ?</h5>
                                    <p class="small text-secondary mb-3">
                                        Votre demande est transmise à notre équipe d'astreinte, qui planifie l'intervention à Abidjan.
                                    </p>
                                    <ul class="list-unstyled small text-secondary d-flex flex-column gap-2 mb-0">
                                        <li>✓ Suivi d'astreinte 24h/24</li>
                                        <li>✓ Historique des pièces et batteries remplacées</li>
                                        <li>✓ Rapport d'intervention sur smartphone</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- Page: WizRenouv - Garanties & Remplacement Matériel (/warranty) -->
    <!-- Mappé sur le modèle Odoo maintenance.equipment -->
    <template id="wizsmith_page_warranty" name="WizRenouv Garanties &amp; Renouvellement">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="py-5 bg-light border-bottom text-center">
                    <div class="container py-4">
                        <span class="badge px-3 py-1 rounded-pill mb-2" style="background: rgba(232,99,10,0.1); color: #E8630A;">
                            Garanties Continues &amp; Renouvellement
                        </span>
                        <h1 class="display-5 fw-extrabold text-dark mb-3" style="color: #1A1A2E;">
                            Services WizRenouv : Vos Équipements Garantis
                        </h1>
                        <p class="lead text-secondary max-w-xl mx-auto fs-6">
                            Consultez la validité de vos garanties matérielles et activez le remplacement préventif par du matériel de dernière génération.
                        </p>
                    </div>
                </section>

                <section class="py-5 bg-white">
                    <div class="container py-lg-4 max-w-xl">
                        <div class="card p-4 p-lg-5 rounded-4 border shadow-sm">
                            <h4 class="fw-bold mb-3 text-dark">Vérification de Garantie Matérielle</h4>
                            <p class="text-secondary small mb-4">
                                Renseignez votre numéro de contrat ou numéro de série IMEI pour vérifier votre statut de garantie.
                            </p>
                            <t t-if="warranty_result">
                                <div t-attf-class="alert #{'alert-success' if warranty_result.get('found') else 'alert-warning'} rounded-3" role="status">
                                    <t t-if="warranty_result.get('found')">
                                        <strong t-esc="warranty_result.get('name')"/> —
                                        <t t-if="warranty_result.get('warranty_date')">garantie jusqu'au <strong t-esc="warranty_result.get('warranty_date')"/>.</t>
                                        <t t-else="">garantie non renseignée, notre équipe vous contactera.</t>
                                    </t>
                                    <t t-elif="warranty_result.get('unavailable')">Le service de vérification est momentanément indisponible. Contactez-nous directement.</t>
                                    <t t-else="">Aucun équipement trouvé pour ce numéro. Vérifiez la saisie ou contactez-nous.</t>
                                </div>
                            </t>
                            <form action="/website/warranty/check" method="get" class="d-flex flex-column gap-3">
                                <div>
                                    <label class="form-label small fw-bold">Numéro de contrat ou IMEI</label>
                                    <input type="text" name="serial" class="form-control" required="required" minlength="4" maxlength="64" placeholder="ex: WZ-2024-ABJ-891"/>
                                </div>
                                <button type="submit" class="btn btn-warning text-white fw-bold py-3 rounded-3" style="background-color: #E8630A; border-color: #E8630A;">
                                    Vérifier mon contrat WizRenouv
                                </button>
                            </form>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

