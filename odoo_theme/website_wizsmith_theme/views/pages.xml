<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WizSmith Homepage Page Template -->
    <template id="wizsmith_homepage" name="WizSmith Homepage">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Section A & B: Hero with Smart Property HUD -->
                <t t-call="website_wizsmith_theme.s_wizsmith_hero"/>

                <!-- Section C: Customer Problems -->
                <t t-call="website_wizsmith_theme.s_wizsmith_problems"/>

                <!-- Section D: Why WizSmith -->
                <t t-call="website_wizsmith_theme.s_wizsmith_why"/>

                <!-- Section E: Solutions by Space -->
                <t t-call="website_wizsmith_theme.s_wizsmith_solutions"/>

                <!-- Section F: AI Property Assessment Preview -->
                <t t-call="website_wizsmith_theme.s_wizsmith_assessment"/>

                <!-- Section G: Subscription Packages -->
                <t t-call="website_wizsmith_theme.s_wizsmith_pricing"/>

                <!-- Section H: Testimonials -->
                <t t-call="website_wizsmith_theme.s_wizsmith_testimonials"/>

                <!-- Section I: Final CTA -->
                <t t-call="website_wizsmith_theme.s_wizsmith_cta"/>
            </div>
        </t>
    </template>

    <!-- Page: Comment ça fonctionne (/comment-ca-fonctionne) -->
    <template id="wizsmith_page_how_it_works" name="Comment ça fonctionne">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Header Banner -->
                <section class="py-5 bg-light border-bottom text-center">
                    <div class="container py-4">
                        <span class="badge px-3 py-1 rounded-pill mb-2" style="background: rgba(0,71,171,0.1); color: #0047AB;">
                            Processus Simple &amp; Garanti
                        </span>
                        <h1 class="display-5 fw-extrabold text-dark mb-3" style="color: #1A1A2E;">Comment fonctionne WizSmith ?</h1>
                        <p class="lead text-secondary max-w-xl mx-auto fs-6">
                            De l'audit initial à votre tranquillité quotidienne : découvrez nos 4 étapes d'automatisation intelligente.
                        </p>
                    </div>
                </section>

                <!-- Workflow Steps -->
                <section class="py-5 bg-white">
                    <div class="container py-lg-4">
                        <div class="row g-4">
                            <!-- Step 1 -->
                            <div class="col-md-6 col-lg-3">
                                <div class="card h-100 p-4 border rounded-4 shadow-xs">
                                    <span class="badge bg-primary rounded-circle mb-3 p-3 align-self-start fs-5" style="background-color: #0047AB !important;">1</span>
                                    <h5 class="fw-bold text-dark mb-2">Audit &amp; Diagnostic</h5>
                                    <p class="text-secondary small">Évaluation en ligne via notre IA ou visite technique sur site à Abidjan pour répertorier vos accès, caméras et habitudes.</p>
                                </div>
                            </div>
                            <!-- Step 2 -->
                            <div class="col-md-6 col-lg-3">
                                <div class="card h-100 p-4 border rounded-4 shadow-xs">
                                    <span class="badge bg-primary rounded-circle mb-3 p-3 align-self-start fs-5" style="background-color: #0047AB !important;">2</span>
                                    <h5 class="fw-bold text-dark mb-2">Installation Certifiée</h5>
                                    <p class="text-secondary small">Pose de serrures intelligentes WizLock, raccordement de vos caméras existantes à notre module IA, configuration réseau.</p>
                                </div>
                            </div>
                            <!-- Step 3 -->
                            <div class="col-md-6 col-lg-3">
                                <div class="card h-100 p-4 border rounded-4 shadow-xs">
                                    <span class="badge bg-primary rounded-circle mb-3 p-3 align-self-start fs-5" style="background-color: #0047AB !important;">3</span>
                                    <h5 class="fw-bold text-dark mb-2">Automatisation sur-mesure</h5>
                                    <p class="text-secondary small">Synchronisation avec vos comptes Airbnb/Booking, paramétrage des alertes IA nocturnes et scénarios éco d'énergie.</p>
                                </div>
                            </div>
                            <!-- Step 4 -->
                            <div class="col-md-6 col-lg-3">
                                <div class="card h-100 p-4 border rounded-4 shadow-xs">
                                    <span class="badge bg-primary rounded-circle mb-3 p-3 align-self-start fs-5" style="background-color: #0047AB !important;">4</span>
                                    <h5 class="fw-bold text-dark mb-2">Tranquillité 24/7</h5>
                                    <p class="text-secondary small">Contrôlez tout depuis votre smartphone. Maintenance continue WizFix et support technique réactif disponible 7j/7.</p>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-5">
                            <a href="/support-ia" class="btn btn-primary px-4 py-3 fw-bold text-white rounded-3" style="background-color: #E8630A; border-color: #E8630A;">
                                Démarrer avec un diagnostic gratuit
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

